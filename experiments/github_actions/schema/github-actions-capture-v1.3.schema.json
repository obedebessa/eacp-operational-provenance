{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/obedebessa/eacp-operational-provenance/eacp-v1.3-candidate/experiments/github_actions/schema/github-actions-capture-v1.3.schema.json",
  "title": "EACP v1.3 minimized GitHub Actions source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "capture",
    "repository",
    "run",
    "jobs",
    "artifacts",
    "projection"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "eacp.github-actions.capture/1.3.0"},
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition",
        "transport",
        "authenticated",
        "captured_at",
        "sanitization_profile",
        "raw_api_payload_retained",
        "excluded"
      ],
      "properties": {
        "acquisition": {
          "enum": ["github-rest-api", "imported-api-json", "imported-actions-artifact"]
        },
        "transport": {"type": "string", "minLength": 1},
        "authenticated": {"type": ["boolean", "null"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "sanitization_profile": {"const": "public-metadata-minimal-v1"},
        "raw_api_payload_retained": {"const": false},
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "full_name", "private", "html_url"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "private": {"type": "boolean"},
        "html_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "run": {"$ref": "#/$defs/run"},
    "jobs": {
      "type": "array",
      "items": {"$ref": "#/$defs/job"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "service",
        "intent",
        "correlation_id",
        "correlation_derivation",
        "kubernetes_target"
      ],
      "properties": {
        "schema_version": {"const": "eacp.evidence/1.3.0"},
        "service": {"type": "string", "minLength": 1, "maxLength": 512},
        "intent": {"const": "software_delivery"},
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]*$"
        },
        "correlation_derivation": {
          "enum": ["repository-id + run-id + run-attempt", "operator-supplied"]
        },
        "kubernetes_target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "name", "namespace", "annotation_key"],
          "properties": {
            "resource": {"const": "deployment"},
            "name": {"type": "string", "minLength": 1},
            "namespace": {"type": "string", "minLength": 1},
            "annotation_key": {"const": "eacp.io/correlation-id"}
          }
        },
        "subject": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["uri", "digest"],
              "properties": {
                "uri": {"type": "string", "minLength": 1, "maxLength": 1024},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "nullableTimestamp": {"type": ["string", "null"], "format": "date-time"},
    "nullableUri": {"type": ["string", "null"], "format": "uri"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "id", "type"],
      "properties": {
        "login": {"type": "string", "minLength": 1},
        "id": {"type": ["integer", "null"]},
        "type": {"type": "string", "minLength": 1},
        "html_url": {"type": "string", "format": "uri"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "run_number",
        "run_attempt",
        "workflow_id",
        "name",
        "path",
        "event",
        "status",
        "conclusion",
        "head_branch",
        "head_sha",
        "created_at",
        "run_started_at",
        "updated_at",
        "html_url",
        "api_url",
        "jobs_url",
        "artifacts_url",
        "actor",
        "triggering_actor"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "node_id": {"type": ["string", "null"]},
        "run_number": {"type": "integer", "minimum": 0},
        "run_attempt": {"type": "integer", "minimum": 1},
        "workflow_id": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "event": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "conclusion": {"type": ["string", "null"]},
        "head_branch": {"type": ["string", "null"]},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "created_at": {"type": "string", "format": "date-time"},
        "run_started_at": {"$ref": "#/$defs/nullableTimestamp"},
        "updated_at": {"type": "string", "format": "date-time"},
        "html_url": {"type": "string", "format": "uri"},
        "api_url": {"$ref": "#/$defs/nullableUri"},
        "jobs_url": {"$ref": "#/$defs/nullableUri"},
        "artifacts_url": {"$ref": "#/$defs/nullableUri"},
        "actor": {"$ref": "#/$defs/actor"},
        "triggering_actor": {"$ref": "#/$defs/actor"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "status", "conclusion", "started_at", "completed_at"],
      "properties": {
        "number": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "conclusion": {"type": ["string", "null"]},
        "started_at": {"$ref": "#/$defs/nullableTimestamp"},
        "completed_at": {"$ref": "#/$defs/nullableTimestamp"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run_id",
        "run_attempt",
        "name",
        "workflow_name",
        "status",
        "conclusion",
        "created_at",
        "started_at",
        "completed_at",
        "html_url",
        "labels",
        "steps"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "workflow_name": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "conclusion": {"type": ["string", "null"]},
        "created_at": {"$ref": "#/$defs/nullableTimestamp"},
        "started_at": {"$ref": "#/$defs/nullableTimestamp"},
        "completed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "html_url": {"$ref": "#/$defs/nullableUri"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "size_in_bytes",
        "expired",
        "created_at",
        "updated_at",
        "expires_at",
        "archive_download_url",
        "workflow_run_id"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "size_in_bytes": {"type": "integer", "minimum": 0},
        "expired": {"type": "boolean"},
        "created_at": {"$ref": "#/$defs/nullableTimestamp"},
        "updated_at": {"$ref": "#/$defs/nullableTimestamp"},
        "expires_at": {"$ref": "#/$defs/nullableTimestamp"},
        "archive_download_url": {"$ref": "#/$defs/nullableUri"},
        "workflow_run_id": {"type": ["integer", "null"]}
      }
    }
  }
}
