{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/obedebessa/eacp-operational-provenance/v1.3.0/spec/schema/eacp-core-evidence-record-v1.3.schema.json",
  "title": "EACP Profile 1.3 core evidence record",
  "description": "A conservative evidence record. It records observations and typed associations; it does not prove authenticity, truth, responsibility, or causality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "source_type",
    "source_id",
    "source_ts",
    "observed_ts",
    "actors",
    "service",
    "intent",
    "policy",
    "action",
    "outcome",
    "source_pointer",
    "links"
  ],
  "properties": {
    "profile": {"const": "eacp.profile/1.3"},
    "source_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "source_id": {"$ref": "#/$defs/nonemptyIdentifier"},
    "source_ts": {"type": "string", "format": "date-time"},
    "observed_ts": {"type": "string", "format": "date-time"},
    "actors": {"$ref": "#/$defs/actors"},
    "service": {"$ref": "#/$defs/service"},
    "intent": {"$ref": "#/$defs/nonemptyText"},
    "policy": {"$ref": "#/$defs/nonemptyText"},
    "action": {"$ref": "#/$defs/nonemptyText"},
    "outcome": {"$ref": "#/$defs/nonemptyText"},
    "source_pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "format": "uri"
    },
    "source_digest": {"$ref": "#/$defs/sourceDigest"},
    "links": {
      "type": "array",
      "items": {"$ref": "#/$defs/link"}
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9.-]*/[A-Za-z0-9][A-Za-z0-9._-]*$": true
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonemptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "nonemptyIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": [
            "global",
            "organization",
            "repository",
            "account",
            "tenant",
            "project",
            "cluster",
            "namespace",
            "environment",
            "system",
            "custom",
            "legacy_dataset"
          ]
        },
        "id": {"$ref": "#/$defs/nonemptyIdentifier"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/nonemptyIdentifier"},
        "type": {
          "enum": [
            "human",
            "service_account",
            "workload_identity",
            "automation",
            "system",
            "unknown",
            "legacy_opaque"
          ]
        },
        "scope": {"$ref": "#/$defs/scope"},
        "display_name": {"$ref": "#/$defs/nonemptyText"}
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initiator": {"$ref": "#/$defs/actor"},
        "triggering_actor": {"$ref": "#/$defs/actor"},
        "execution_principal": {"$ref": "#/$defs/actor"},
        "attester": {"$ref": "#/$defs/actor"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/nonemptyIdentifier"},
        "type": {
          "enum": [
            "logical_service",
            "application",
            "repository",
            "workload",
            "kubernetes_resource",
            "cloud_service",
            "system",
            "unknown",
            "legacy_opaque"
          ]
        },
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "representation"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512"]},
        "value": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "representation": {
          "enum": [
            "raw_bytes",
            "canonical_json",
            "sanitized_canonical_json",
            "adapter_defined"
          ]
        },
        "canonicalization": {"$ref": "#/$defs/nonemptyText"}
      },
      "allOf": [
        {
          "if": {"properties": {"algorithm": {"const": "sha256"}}},
          "then": {"properties": {"value": {"pattern": "^[0-9a-f]{64}$"}}},
          "else": {"properties": {"value": {"pattern": "^[0-9a-f]{128}$"}}}
        },
        {
          "if": {"properties": {"representation": {"const": "raw_bytes"}}},
          "else": {"required": ["canonicalization"]}
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "scope", "evidence_method"],
      "properties": {
        "type": {
          "enum": [
            "operational_correlation",
            "vcs_revision",
            "artifact_digest",
            "deployment_uid",
            "workflow_run",
            "policy_decision",
            "incident_id",
            "trace_id",
            "recovery_point",
            "ticket_id",
            "custom"
          ]
        },
        "custom_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "value": {"$ref": "#/$defs/nonemptyIdentifier"},
        "scope": {"$ref": "#/$defs/scope"},
        "evidence_method": {
          "enum": ["source_native", "explicit", "digest_match", "inferred"]
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "custom"}}},
          "then": {"required": ["custom_type"]},
          "else": {"not": {"required": ["custom_type"]}}
        },
        {
          "if": {"properties": {"evidence_method": {"const": "inferred"}}},
          "then": {"required": ["confidence"]},
          "else": {"not": {"required": ["confidence"]}}
        },
        {
          "if": {"properties": {"evidence_method": {"const": "digest_match"}}},
          "then": {
            "properties": {
              "type": {"const": "artifact_digest"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "artifact_digest"}}},
          "then": {
            "properties": {
              "value": {
                "pattern": "^(?:sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
              }
            }
          }
        }
      ]
    }
  }
}
