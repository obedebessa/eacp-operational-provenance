{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/obedebessa/eacp-operational-provenance/v1.3.0/spec/schema/eacp-link-resolution-v1.3.schema.json",
  "title": "EACP Profile 1.3 safe link resolution result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "query",
    "status",
    "abstained",
    "selected_link",
    "matches",
    "ambiguous_candidates",
    "excluded_ambiguous_records",
    "reason"
  ],
  "properties": {
    "profile": {"const": "eacp.link-resolution/1.3"},
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "link_type", "allow_inferred", "minimum_confidence"],
      "properties": {
        "source_key": {"$ref": "#/$defs/sourceKey"},
        "link_type": {"$ref": "#/$defs/linkType"},
        "custom_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "scope": {"$ref": "#/$defs/scope"},
        "allow_inferred": {"type": "boolean"},
        "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"link_type": {"const": "custom"}}},
          "then": {"required": ["custom_type"]},
          "else": {"not": {"required": ["custom_type"]}}
        }
      ]
    },
    "status": {"enum": ["resolved", "missing", "ambiguous"]},
    "abstained": {"type": "boolean"},
    "selected_link": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/linkKey"}]
    },
    "matches": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceKey"},
      "uniqueItems": true
    },
    "ambiguous_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/linkKey"},
      "uniqueItems": true
    },
    "excluded_ambiguous_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceKey"},
      "uniqueItems": true
    },
    "reason": {
      "enum": [
        "one_exact_link_key",
        "no_eligible_link",
        "multiple_eligible_link_keys"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "resolved"}}},
      "then": {
        "properties": {
          "abstained": {"const": false},
          "selected_link": {"$ref": "#/$defs/linkKey"},
          "matches": {"minItems": 1},
          "ambiguous_candidates": {"maxItems": 0},
          "reason": {"const": "one_exact_link_key"}
        }
      },
      "else": {
        "properties": {
          "abstained": {"const": true},
          "selected_link": {"type": "null"},
          "matches": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "missing"}}},
      "then": {
        "properties": {
          "ambiguous_candidates": {"maxItems": 0},
          "reason": {"const": "no_eligible_link"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "ambiguous"}}},
      "then": {
        "properties": {
          "ambiguous_candidates": {"minItems": 2},
          "reason": {"const": "multiple_eligible_link_keys"}
        }
      }
    }
  ],
  "$defs": {
    "linkType": {
      "enum": [
        "operational_correlation",
        "vcs_revision",
        "artifact_digest",
        "deployment_uid",
        "workflow_run",
        "policy_decision",
        "incident_id",
        "trace_id",
        "recovery_point",
        "ticket_id",
        "custom"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "sourceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1}
      }
    },
    "linkKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope", "value"],
      "properties": {
        "type": {"$ref": "#/$defs/linkType"},
        "custom_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "scope": {"$ref": "#/$defs/scope"},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "custom"}}},
          "then": {"required": ["custom_type"]},
          "else": {"not": {"required": ["custom_type"]}}
        }
      ]
    }
  }
}
